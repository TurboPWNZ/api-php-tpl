#!/usr/bin/env php
<?php
/**
 * Simple migration runner for standalone illuminate/database.
 *
 * Usage:
 *   php artisan migrate          — run pending migrations
 *   php artisan migrate:rollback — rollback last batch
 *   php artisan migrate:refresh  — rollback all + re-migrate
 *   php artisan migrate:status   — show migration status
 *
 * Очередь генераций (см. Api\components\queue\GenerationQueue):
 *   php artisan queue:work               — воркер (systemd), tick каждые queue.pollInterval сек
 *   php artisan queue:tick               — один проход очереди (отладка)
 *   php artisan queue:status             — сколько заказов в каких статусах
 *
 * Пул ИИ-серверов (ai_servers):
 *   php artisan servers:list
 *   php artisan servers:add <name> <url> — например: servers:add gpu1 http://10.0.0.5:8188
 *                                          (в окружение из config queue.env)
 *   php artisan servers:enable <id>
 *   php artisan servers:disable <id>     — не получает новых заказов, текущий досчитает
 *
 * Шаблоны генерации (templates; БД общая — можно запускать и локально):
 *   php artisan templates:list
 *   php artisan templates:import-default --name=... [--before=f --after=f]
 *       — шаблон из текущего конфига (comfyui.i2i.workflow, systemPromt[Guest],
 *         generate.costBase/costWithPrompt)
 *   php artisan templates:add --name=... --cost=4 --cost-with-prompt=8 --prompt=... \
 *       --workflow=comfy/workflow/x.json [--prompt-guest=...] [--before=f --after=f] [--sort=N]
 *   php artisan templates:set <id> [любые опции из templates:add]
 *   php artisan templates:enable <id> / templates:disable <id>
 */

require __DIR__ . '/vendor/autoload.php';

use Api\db\DatabaseManager;
use Illuminate\Database\ConnectionResolver;
use Illuminate\Database\Migrations\Migrator;
use Illuminate\Filesystem\Filesystem;

// ─── Boot capsule ───────────────────────────────────────────────────────────

$capsule = DatabaseManager::boot();
$connection = $capsule->getConnection();

// ─── Setup migration repository ─────────────────────────────────────────────

$resolver = new ConnectionResolver();
$resolver->addConnection('default', $connection);
$resolver->setDefaultConnection('default');

$repo = new \Illuminate\Database\Migrations\DatabaseMigrationRepository(
    $resolver,
    'migrations'
);

if (!$repo->repositoryExists()) {
    $repo->createRepository();
}

// ─── Setup migrator ──────────────────────────────────────────────────────────

$migrator = new Migrator(
    $repo,
    $resolver,
    new Filesystem()
);

$paths = [__DIR__ . '/database/migrations'];

// ─── Commands ────────────────────────────────────────────────────────────────

$command = $argv[1] ?? 'migrate';

/** --key=value аргументы (для templates:*). */
function artisanOptions(array $argv): array
{
    $options = [];
    foreach (array_slice($argv, 2) as $arg) {
        if (preg_match('/^--([a-z-]+)=(.*)$/s', $arg, $m)) {
            $options[$m[1]] = $m[2];
        }
    }

    return $options;
}

/** Применяет опции templates:add/set к шаблону. @throws InvalidArgumentException */
function applyTemplateOptions(\Api\db\Template $template, array $opts): void
{
    $map = ['name' => 'name', 'cost' => 'cost', 'cost-with-prompt' => 'cost_with_prompt',
        'prompt' => 'prompt', 'prompt-guest' => 'prompt_guest', 'sort' => 'sort'];
    foreach ($map as $opt => $column) {
        if (array_key_exists($opt, $opts)) {
            $template->{$column} = $opts[$opt] === '' && $opt === 'prompt-guest' ? null : $opts[$opt];
        }
    }
    foreach (['cost', 'cost-with-prompt'] as $opt) {
        if (array_key_exists($opt, $opts) && (!is_numeric($opts[$opt]) || $opts[$opt] < 0)) {
            throw new InvalidArgumentException("--{$opt} must be a non-negative number");
        }
    }
    if (isset($opts['workflow'])) {
        $template->workflow = \Api\db\Template::readWorkflowFile($opts['workflow']);
    }
    foreach (['before', 'after'] as $side) {
        if (isset($opts[$side])) {
            $template->setPreviewFromFile($side, $opts[$side]);
        }
    }
}

switch ($command) {
    case 'migrate':
        $migrator->run($paths);
        echo "Migration complete.\n";
        break;

    case 'migrate:rollback':
        $migrator->rollback($paths);
        echo "Rollback complete.\n";
        break;

    case 'migrate:refresh':
        $migrator->reset($paths);
        $migrator->run($paths);
        echo "Refresh complete.\n";
        break;

    case 'migrate:status':
        $ran = $repo->getRan();
        $files = array_map(
            fn($f) => basename($f, '.php'),
            glob(__DIR__ . '/database/migrations/*.php') ?: []
        );
        sort($files);

        if (empty($files)) {
            echo "No migrations found.\n";
        } else {
            foreach ($files as $file) {
                $status = in_array($file, $ran) ? '[Done]' : '[Pending]';
                printf("%s %s\n", $status, $file);
            }
        }
        break;

    case 'queue:work':
        $queue = new \Api\components\queue\GenerationQueue();
        $queueConfig = \Api\Configurator::getConfig()['queue'] ?? [];
        $pollInterval = max(1, (int)($queueConfig['pollInterval'] ?? 2));
        // Выходим раз в час — systemd (Restart=always) поднимет заново:
        // свежий код после git pull и свежее соединение с БД.
        $maxRuntime = (int)($queueConfig['workerMaxRuntime'] ?? 3600);
        $startedAt = time();

        $stop = false;
        if (function_exists('pcntl_async_signals')) {
            pcntl_async_signals(true);
            pcntl_signal(SIGTERM, function () use (&$stop) { $stop = true; });
            pcntl_signal(SIGINT, function () use (&$stop) { $stop = true; });
        }

        echo "Queue worker started (env " . \Api\Configurator::queueEnv() . ", poll every {$pollInterval}s)\n";
        while (!$stop && time() - $startedAt < $maxRuntime) {
            try {
                $queue->tick();
            } catch (\Throwable $e) {
                \Api\components\Log::get('queue')->error('Queue tick failed', [
                    'error' => $e->getMessage(), 'file' => $e->getFile() . ':' . $e->getLine(),
                ]);
                sleep(5);
            }
            sleep($pollInterval);
        }
        echo "Queue worker stopped\n";
        break;

    case 'queue:tick':
        $ran = (new \Api\components\queue\GenerationQueue())->tick();
        echo $ran ? "Tick done.\n" : "Another worker holds the queue lock, skipped.\n";
        break;

    case 'queue:status':
        $env = \Api\Configurator::queueEnv();
        $counts = \Api\db\Generation::query()
            ->where('env', $env)
            ->selectRaw('status, COUNT(*) AS cnt')
            ->groupBy('status')
            ->pluck('cnt', 'status');
        echo "env {$env}:\n";
        foreach ($counts as $status => $cnt) {
            printf("  %-12s %d\n", $status, $cnt);
        }
        break;

    case 'servers:list':
        // Все окружения — чтобы было видно и чужие серверы в общей БД.
        $servers = \Api\db\AiServer::orderBy('env')->orderBy('id')->get();
        if ($servers->isEmpty()) {
            echo "No servers. Add one: php artisan servers:add <name> <url>\n";
            break;
        }
        echo "Current env: " . \Api\Configurator::queueEnv() . "\n";
        printf("%-4s %-6s %-12s %-44s %-8s %-8s %-6s %s\n", 'ID', 'ENV', 'NAME', 'URL', 'STATUS', 'ENABLED', 'GEN', 'LAST ERROR');
        foreach ($servers as $server) {
            printf("%-4d %-6s %-12s %-44s %-8s %-8s %-6s %s\n",
                $server->id, $server->env, $server->name, $server->url, $server->status,
                $server->enabled ? 'yes' : 'no', $server->generation_id ?? '-',
                mb_substr((string)$server->last_error, 0, 60));
        }
        break;

    case 'servers:add':
        $name = $argv[2] ?? '';
        $url = rtrim($argv[3] ?? '', '/');
        if ($name === '' || !preg_match('#^https?://#', $url)) {
            echo "Usage: php artisan servers:add <name> <url>   (url like http://10.0.0.5:8188)\n";
            exit(1);
        }
        // offline: воркер сам проверит /queue и переведёт в free, если сервер живой.
        // env — текущее окружение (config queue.env): сервер увидит только воркер этого окружения.
        $server = \Api\db\AiServer::create([
            'env' => \Api\Configurator::queueEnv(),
            'name' => $name,
            'url' => $url,
            'status' => \Api\db\AiServer::STATUS_OFFLINE,
        ]);
        echo "Added server #{$server->id} [{$server->env}] {$name} {$url} (status offline until the worker health-checks it)\n";
        break;

    case 'servers:enable':
    case 'servers:disable':
        $server = \Api\db\AiServer::find((int)($argv[2] ?? 0));
        if ($server === null) {
            echo "Server not found. Usage: php artisan {$command} <id>\n";
            exit(1);
        }
        $server->forceFill(['enabled' => $command === 'servers:enable'])->save();
        echo "Server #{$server->id} {$server->name}: " . ($server->enabled ? 'enabled' : 'disabled') . "\n";
        break;

    case 'templates:list':
        $templates = \Api\db\Template::withoutBlobs()->orderBy('sort')->orderBy('id')->get();
        if ($templates->isEmpty()) {
            echo "No templates. Create one: php artisan templates:import-default --name=...\n";
            break;
        }
        printf("%-4s %-5s %-24s %-8s %-8s %-8s %-6s %-6s %s\n", 'ID', 'SORT', 'NAME', 'ENABLED', 'COST', '+PROMPT', 'BEFORE', 'AFTER', 'PROMPT');
        foreach ($templates as $template) {
            // printf считает байты — кириллическое имя добиваем пробелами сами.
            $name = mb_substr($template->name, 0, 24);
            printf("%-4d %-5d %s %-8s %-8s %-8s %-6s %-6s %s\n",
                $template->id, $template->sort, $name . str_repeat(' ', 24 - mb_strlen($name)), $template->enabled ? 'yes' : 'no',
                $template->cost, $template->cost_with_prompt,
                $template->preview_before_mime ? 'yes' : '-', $template->preview_after_mime ? 'yes' : '-',
                mb_substr($template->prompt, 0, 50));
        }
        break;

    case 'templates:import-default':
    case 'templates:add':
        $opts = artisanOptions($argv);
        if ($command === 'templates:import-default') {
            $cfg = \Api\Configurator::getConfig();
            $opts += [
                'workflow' => __DIR__ . '/' . ltrim((string)($cfg['comfyui']['i2i']['workflow'] ?? ''), '/'),
                'prompt' => (string)($cfg['comfyui']['i2i']['systemPromt'] ?? ''),
                'prompt-guest' => (string)($cfg['comfyui']['i2i']['systemPromtGuest'] ?? ''),
                'cost' => (string)($cfg['generate']['costBase'] ?? 4),
                'cost-with-prompt' => (string)($cfg['generate']['costWithPrompt'] ?? 8),
            ];
        }
        foreach (['name', 'cost', 'cost-with-prompt', 'prompt', 'workflow'] as $required) {
            if (!isset($opts[$required]) || $opts[$required] === '') {
                echo "Missing --{$required}. See the usage at the top of artisan.\n";
                exit(1);
            }
        }
        $template = new \Api\db\Template(['enabled' => true]);
        try {
            applyTemplateOptions($template, $opts);
        } catch (InvalidArgumentException $e) {
            echo $e->getMessage() . "\n";
            exit(1);
        }
        $template->save();
        echo "Created template #{$template->id} {$template->name}\n";
        break;

    case 'templates:set':
        $template = \Api\db\Template::find((int)($argv[2] ?? 0));
        if ($template === null) {
            echo "Template not found. Usage: php artisan templates:set <id> --option=value ...\n";
            exit(1);
        }
        try {
            applyTemplateOptions($template, artisanOptions($argv));
        } catch (InvalidArgumentException $e) {
            echo $e->getMessage() . "\n";
            exit(1);
        }
        $template->save();
        echo "Updated template #{$template->id} {$template->name}\n";
        break;

    case 'templates:enable':
    case 'templates:disable':
        $template = \Api\db\Template::find((int)($argv[2] ?? 0));
        if ($template === null) {
            echo "Template not found. Usage: php artisan {$command} <id>\n";
            exit(1);
        }
        $template->forceFill(['enabled' => $command === 'templates:enable'])->save();
        echo "Template #{$template->id} {$template->name}: " . ($template->enabled ? 'enabled' : 'disabled') . "\n";
        break;

    default:
        echo "Usage: php artisan <migrate|migrate:rollback|migrate:refresh|migrate:status|queue:work|queue:tick|queue:status|servers:list|servers:add|servers:enable|servers:disable|templates:list|templates:add|templates:import-default|templates:set|templates:enable|templates:disable>\n";
        exit(1);
}
